/* ════════════════════════════════════════════════════════
   Rajeswari Ramanaboina — Portfolio
   style.css

   Theme: Pink + White. Light surfaces, soft pink gradients,
   dark text for readability. No custom cursor anywhere.
   ════════════════════════════════════════════════════════ */

/* ── 1. DESIGN TOKENS ─────────────────────────────────── */
:root{
  /* Surfaces */
  --white:      #ffffff;
  --shell:      #fffafc;   /* page background — barely-there pink */
  --surface:    #ffffff;
  --surface-2:  #fdf2f6;   /* soft pink wash */
  --surface-3:  #fce7ef;   /* deeper pink wash */

  /* Pinks */
  --pink-100:   #ffeef4;
  --pink-200:   #ffd9e6;
  --pink-300:   #ffbcd2;
  --pink-400:   #ff8fb4;
  --pink-500:   #f2649a;   /* primary */
  --pink-600:   #d94a80;   /* primary pressed */
  --pink-700:   #b03464;   /* deep accent text */

  /* Ink */
  --ink:        #1d1218;
  --ink-2:      #4a3540;
  --ink-3:      #7d6772;
  --ink-4:      #ab97a1;

  /* Lines + shadow */
  --line:       rgba(242,100,154,0.16);
  --line-2:     rgba(242,100,154,0.32);
  --sh-1:       0 1px 2px rgba(176,52,100,0.05), 0 4px 14px rgba(176,52,100,0.06);
  --sh-2:       0 4px 12px rgba(176,52,100,0.08), 0 16px 40px rgba(176,52,100,0.10);
  --sh-3:       0 12px 28px rgba(176,52,100,0.12), 0 32px 70px rgba(176,52,100,0.14);
  --sh-pink:    0 8px 26px rgba(242,100,154,0.30);

  /* Type */
  --font-display: 'Fraunces', Georgia, serif;
  --font-body:    'Manrope', system-ui, -apple-system, sans-serif;
  --font-mono:    'JetBrains Mono', ui-monospace, monospace;

  /* Layout */
  --maxw:  1240px;
  --pad-x: 56px;
  --radius:   16px;
  --radius-s: 10px;
  --radius-l: 24px;

  /* Motion */
  --ease: cubic-bezier(.22,.61,.36,1);
}

/* ── 2. RESET ─────────────────────────────────────────── */
*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }

html{
  scroll-behavior:smooth;
  scroll-padding-top:96px;   /* so anchors clear the sticky nav */
  -webkit-text-size-adjust:100%;
}

body{
  background:var(--shell);
  color:var(--ink);
  font-family:var(--font-body);
  font-weight:400;
  font-size:16px;
  line-height:1.6;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  /* NOTE: cursor is intentionally never modified anywhere in this file.
     The visitor's normal OS mouse arrow is always used. */
}

img{ max-width:100%; display:block; }
ul,ol{ list-style:none; }
a{ color:inherit; text-decoration:none; }
button{ font:inherit; border:none; background:none; }

/* Accessible focus ring */
a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible{
  outline:2px solid var(--pink-500);
  outline-offset:3px;
  border-radius:4px;
}

.skip-link{
  position:absolute; left:-9999px; top:0; z-index:9999;
  background:var(--pink-500); color:#fff;
  padding:12px 20px; border-radius:0 0 var(--radius-s) 0;
  font-size:14px; font-weight:600;
}
.skip-link:focus{ left:0; }

::-webkit-scrollbar{ width:10px; }
::-webkit-scrollbar-track{ background:var(--surface-2); }
::-webkit-scrollbar-thumb{
  background:var(--pink-300); border-radius:5px;
  border:3px solid var(--surface-2);
}
::-webkit-scrollbar-thumb:hover{ background:var(--pink-400); }

::selection{ background:var(--pink-200); color:var(--pink-700); }

/* ── 3. THREE.JS CANVAS ───────────────────────────────── */
#heroCanvas{
  position:fixed; inset:0;
  width:100%; height:100%;
  z-index:0;
  pointer-events:none;
}

/* ── 4. SCROLL PROGRESS ───────────────────────────────── */
#progressBar{
  position:fixed; top:0; left:0; z-index:999;
  height:3px; width:0;
  background:linear-gradient(90deg,var(--pink-300),var(--pink-500),var(--pink-400));
  transition:width .1s linear;
}

/* ── 5. NAVIGATION ────────────────────────────────────── */
header{
  position:fixed; top:0; left:0; right:0; z-index:200;
  padding:14px 0;
  background:rgba(255,255,255,0.72);
  backdrop-filter:blur(20px) saturate(1.4);
  -webkit-backdrop-filter:blur(20px) saturate(1.4);
  border-bottom:1px solid var(--line);
  transition:padding .3s var(--ease), box-shadow .3s var(--ease);
}
header.is-scrolled{
  padding:9px 0;
  box-shadow:0 4px 24px rgba(176,52,100,0.07);
}

.nav{
  max-width:var(--maxw); margin:0 auto;
  padding:0 var(--pad-x);
  display:flex; align-items:center; justify-content:space-between; gap:24px;
}

.brand{ display:flex; align-items:center; gap:10px; }
.brand-mark{
  width:34px; height:34px; flex:0 0 34px;
  border-radius:10px;
  background:linear-gradient(135deg,var(--pink-400),var(--pink-600));
  color:#fff;
  display:grid; place-items:center;
  font-family:var(--font-display); font-weight:900; font-size:17px;
  box-shadow:var(--sh-pink);
}
.brand-text{
  font-family:var(--font-display);
  font-weight:600; font-size:18px; letter-spacing:-.01em;
}
.brand-text em{ color:var(--pink-500); font-style:normal; }

.nav-list{ display:flex; gap:30px; }
.nav-list a{
  font-size:13.5px; font-weight:500; color:var(--ink-3);
  position:relative; padding:4px 0;
  transition:color .2s var(--ease);
}
.nav-list a::after{
  content:''; position:absolute; left:0; bottom:-2px;
  width:0; height:2px; border-radius:1px;
  background:var(--pink-500);
  transition:width .28s var(--ease);
}
.nav-list a:hover,
.nav-list a.is-active{ color:var(--ink); }
.nav-list a:hover::after,
.nav-list a.is-active::after{ width:100%; }

.nav-actions{ display:flex; align-items:center; gap:14px; }

.status-chip{
  display:inline-flex; align-items:center; gap:8px;
  padding:7px 15px; border-radius:100px;
  background:var(--pink-100);
  border:1px solid var(--line);
  font-size:12px; font-weight:600; color:var(--pink-700);
  white-space:nowrap;
}
.status-dot{
  width:7px; height:7px; border-radius:50%;
  background:var(--pink-500);
  animation:ping 1.8s ease-out infinite;
}
@keyframes ping{
  0%{ box-shadow:0 0 0 0 rgba(242,100,154,.5); }
  70%{ box-shadow:0 0 0 8px rgba(242,100,154,0); }
  100%{ box-shadow:0 0 0 0 rgba(242,100,154,0); }
}

/* Hamburger */
.burger{
  display:none; flex-direction:column; gap:5px;
  padding:6px; border-radius:8px;
}
.burger span{
  display:block; width:22px; height:2px; border-radius:1px;
  background:var(--pink-600);
  transition:transform .3s var(--ease), opacity .2s;
}
.burger.is-open span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
.burger.is-open span:nth-child(2){ opacity:0; }
.burger.is-open span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }

.mobile-overlay{
  position:fixed; inset:0; z-index:150;
  background:rgba(29,18,24,.35);
  opacity:0; pointer-events:none;
  transition:opacity .3s var(--ease);
}
.mobile-overlay.is-open{ opacity:1; pointer-events:auto; }

.mobile-nav{
  position:fixed; top:0; right:-320px; z-index:160;
  width:290px; height:100vh;
  background:var(--white);
  border-left:1px solid var(--line);
  box-shadow:-16px 0 50px rgba(176,52,100,.12);
  padding:100px 34px 34px;
  display:flex; flex-direction:column;
  transition:right .34s var(--ease);
}
.mobile-nav.is-open{ right:0; }
.mobile-nav a{
  padding:15px 0;
  border-bottom:1px solid var(--line);
  font-size:15px; font-weight:600; color:var(--ink-2);
  transition:color .2s, padding-left .2s var(--ease);
}
.mobile-nav a:hover{ color:var(--pink-600); padding-left:6px; }

/* ── 6. BUTTONS ───────────────────────────────────────── */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:14px 30px; border-radius:100px;
  font-size:14px; font-weight:600; letter-spacing:.01em;

  transition:transform .25s var(--ease), box-shadow .25s var(--ease),
             background .25s, color .25s, border-color .25s;
  will-change:transform;
}
.btn-primary{
  background:linear-gradient(135deg,var(--pink-400),var(--pink-600));
  color:#fff;
  box-shadow:var(--sh-pink);
}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 32px rgba(242,100,154,.42);
}
.btn-ghost{
  background:var(--white);
  color:var(--ink);
  border:1.5px solid var(--line-2);
  box-shadow:var(--sh-1);
}
.btn-ghost:hover{
  transform:translateY(-2px);
  border-color:var(--pink-400);
  color:var(--pink-700);
  box-shadow:var(--sh-2);
}
.btn-block{ width:100%; }

.chip{
  display:inline-flex; align-items:center;
  padding:8px 18px; border-radius:100px;
  background:var(--white);
  border:1px solid var(--line);
  font-size:13px; font-weight:600; color:var(--ink-2);
  box-shadow:var(--sh-1);
  transition:transform .22s var(--ease), border-color .22s, color .22s, box-shadow .22s;
}
.chip:hover{
  transform:translateY(-2px);
  border-color:var(--pink-400);
  color:var(--pink-700);
  box-shadow:var(--sh-2);
}
.chip-muted{
  color:var(--ink-4);
  border-style:dashed;
}

/* ── 7. HERO ──────────────────────────────────────────── */
.hero{
  position:relative; z-index:1;
  min-height:100vh;
  display:flex; align-items:center;
  padding:150px var(--pad-x) 90px;
  overflow:hidden;
}
/* soft pink light behind the hero */
.hero::before{
  content:''; position:absolute; z-index:-1;
  width:820px; height:820px; top:-260px; right:-200px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(255,188,210,.42),transparent 66%);
  filter:blur(30px);
  pointer-events:none;
}
.hero::after{
  content:''; position:absolute; z-index:-1;
  width:560px; height:560px; bottom:-200px; left:-160px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(255,217,230,.5),transparent 66%);
  filter:blur(30px);
  pointer-events:none;
}

.hero-inner{
  width:100%; max-width:var(--maxw); margin:0 auto;
  display:grid; grid-template-columns:1.05fr .95fr;
  gap:60px; align-items:center;
}

.eyebrow{
  display:flex; align-items:center; gap:12px;
  font-family:var(--font-mono);
  font-size:11.5px; letter-spacing:.16em; text-transform:uppercase;
  color:var(--pink-700);
  margin-bottom:24px;
  animation:rise .8s var(--ease) both;
}
.eyebrow-line{
  width:38px; height:2px; border-radius:1px;
  background:linear-gradient(90deg,var(--pink-400),var(--pink-200));
}

.hero-title{
  font-family:var(--font-display);
  font-size:clamp(46px,6.6vw,86px);
  font-weight:900; line-height:.98; letter-spacing:-.035em;
  margin-bottom:18px;
}
.hero-title .line{ display:block; animation:rise .8s var(--ease) both; }
.hero-title .line:nth-child(1){ animation-delay:.06s; }
.hero-title .line:nth-child(2){ animation-delay:.14s; }
.hero-title .accent{
  background:linear-gradient(100deg,var(--pink-500),var(--pink-700) 55%,var(--pink-400));
  -webkit-background-clip:text; background-clip:text;
  -webkit-text-fill-color:transparent; color:transparent;
}

.hero-role{
  font-family:var(--font-mono);
  font-size:13px; color:var(--ink-3);
  margin-bottom:26px;
  animation:rise .8s .2s var(--ease) both;
}
.hero-role .mono{ color:var(--pink-500); }
.hero-role .sep{ color:var(--pink-300); margin:0 6px; }

.hero-lead{
  font-size:17px; line-height:1.78; color:var(--ink-2);
  max-width:520px; margin-bottom:34px;
  animation:rise .8s .26s var(--ease) both;
}
.hero-lead strong{ color:var(--ink); font-weight:600; }

.hero-cta{
  display:flex; gap:13px; flex-wrap:wrap; margin-bottom:30px;
  animation:rise .8s .32s var(--ease) both;
}
.hero-links{
  display:flex; gap:10px; flex-wrap:wrap;
  animation:rise .8s .38s var(--ease) both;
}

/* Hero visual — portrait ring + floating credential badges */
.hero-visual{
  position:relative;
  display:grid; place-items:center;
  min-height:460px;
  animation:rise 1s .42s var(--ease) both;
}

.portrait-frame{
  position:relative;
  width:min(360px,78vw);
  aspect-ratio:1;
  display:grid; place-items:center;
}

/* Rotating gradient rings behind the photo */
.pf-ring{
  position:absolute; inset:-14px;
  border-radius:50%;
  background:conic-gradient(from 0deg,
    var(--pink-200), var(--pink-400), var(--pink-600),
    var(--pink-300), var(--pink-200));
  filter:blur(1px);
  opacity:.9;
  animation:spin 18s linear infinite;
}
.pf-ring-2{
  inset:-30px;
  background:none;
  border:1.5px dashed var(--pink-300);
  opacity:.55;
  filter:none;
  animation:spin 34s linear infinite reverse;
}
@keyframes spin{ to{ transform:rotate(360deg); } }

/* White gap so the ring reads as a ring, not a glow */
.pf-photo{
  position:relative; z-index:2;
  transition:transform .35s var(--ease);
  width:100%; height:100%;
  border-radius:50%;
  overflow:hidden;
  border:7px solid var(--white);
  box-shadow:var(--sh-3);
  background:var(--surface-2);
}
.pf-photo img{
  width:100%; height:100%;
  object-fit:cover;
  object-position:center 18%;
  transition:transform .7s var(--ease);
}
.portrait-frame:hover .pf-photo img{ transform:scale(1.045); }

/* Floating credential badges */
.float-badge{
  position:absolute; z-index:3;
  display:flex; align-items:center; gap:10px;
  padding:11px 16px;
  border-radius:100px;
  background:rgba(255,255,255,0.86);
  backdrop-filter:blur(16px) saturate(1.5);
  -webkit-backdrop-filter:blur(16px) saturate(1.5);
  border:1px solid var(--line);
  box-shadow:var(--sh-2);
  white-space:nowrap;
  will-change:transform;
}
.fb-1{ top:4%;   right:-12%; animation:bob 5s ease-in-out infinite; }
.fb-2{ bottom:20%; left:-20%; animation:bob 5s 1.6s ease-in-out infinite; }
.fb-3{ bottom:-2%; right:-6%; animation:bob 5s 3.2s ease-in-out infinite; }

@keyframes bob{
  0%,100%{ transform:translate(var(--px,0), calc(var(--py,0px) + 0px)); }
  50%    { transform:translate(var(--px,0), calc(var(--py,0px) - 9px)); }
}

.fb-icon{
  width:30px; height:30px; flex:0 0 30px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--pink-100),var(--pink-200));
  display:grid; place-items:center; font-size:14px;
}
.fb-body{ display:flex; flex-direction:column; }
.fb-body strong{
  font-size:12.5px; font-weight:700; letter-spacing:-.005em;
  line-height:1.25;
}
.fb-body small{ font-size:10.5px; color:var(--ink-3); line-height:1.3; }

.scroll-hint{
  position:absolute; bottom:34px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  font-family:var(--font-mono);
  font-size:10px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--ink-4);
}
.scroll-hint span{
  width:1px; height:34px;
  background:linear-gradient(to bottom,var(--pink-400),transparent);
  animation:drop 1.9s ease-in-out infinite;
}
@keyframes drop{
  0%,100%{ opacity:.3; transform:scaleY(.55); transform-origin:top; }
  50%    { opacity:1;  transform:scaleY(1);   transform-origin:top; }
}

@keyframes rise{
  from{ opacity:0; transform:translateY(24px); }
  to  { opacity:1; transform:translateY(0); }
}

/* ── 8. SECTION SHELL ─────────────────────────────────── */
.section{
  position:relative; z-index:1;
  max-width:var(--maxw); margin:0 auto;
  padding:96px var(--pad-x);
}

.section-head{
  display:flex; align-items:center; gap:18px;
  margin-bottom:46px;
}
.section-num{
  font-family:var(--font-mono);
  font-size:12px; font-weight:500; letter-spacing:.1em;
  color:var(--pink-500);
}
.section-title{
  font-family:var(--font-display);
  font-size:clamp(28px,3.9vw,46px);
  font-weight:900; letter-spacing:-.03em; line-height:1;
}
.section-rule{
  flex:1; height:1px;
  background:linear-gradient(90deg,var(--line-2),transparent);
}
.section-note{
  font-size:15px; color:var(--ink-3);
  max-width:640px; margin:-26px 0 40px;
}

/* ── 9. ABOUT ─────────────────────────────────────────── */
.about-grid{
  display:grid; grid-template-columns:1.05fr .95fr;
  gap:60px; align-items:start;
}
.about-body .lead{
  font-family:var(--font-display);
  font-size:23px; font-weight:600; line-height:1.42;
  letter-spacing:-.015em;
  margin-bottom:20px;
}
.about-body .lead strong{ color:var(--pink-700); font-weight:600; }
.about-body p{
  font-size:15.5px; line-height:1.85; color:var(--ink-2);
  margin-bottom:16px;
}

.about-cards{
  display:grid; grid-template-columns:1fr 1fr; gap:14px;
  perspective:1000px;
}
.tilt-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:24px 22px;
  box-shadow:var(--sh-1);
  transform-style:preserve-3d;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease),
             border-color .35s;
  will-change:transform;
}
.tilt-card:hover{
  border-color:var(--pink-300);
  box-shadow:var(--sh-2);
}
.tc-icon{
  width:40px; height:40px; border-radius:11px;
  background:linear-gradient(135deg,var(--pink-100),var(--pink-200));
  display:grid; place-items:center;
  font-size:19px; margin-bottom:13px;
}
.tilt-card h3{
  font-family:var(--font-display);
  font-size:15px; font-weight:600; letter-spacing:-.01em;
  margin-bottom:5px;
}
.tilt-card p{ font-size:13px; line-height:1.62; color:var(--ink-3); }

/* ── 10. SKILLS ───────────────────────────────────────── */
.skills-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:16px;
  perspective:1200px;
}
.skill-panel{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:26px 24px;
  box-shadow:var(--sh-1);
  transform-style:preserve-3d;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease),
             border-color .35s;
  will-change:transform;
}
.skill-panel:hover{
  border-color:var(--pink-300);
  box-shadow:var(--sh-2);
}
.sp-head{
  display:flex; align-items:center; gap:12px;
  margin-bottom:18px; padding-bottom:15px;
  border-bottom:1px solid var(--line);
}
.sp-icon{
  width:38px; height:38px; flex:0 0 38px; border-radius:11px;
  background:linear-gradient(135deg,var(--pink-100),var(--pink-200));
  display:grid; place-items:center; font-size:17px;
}
.sp-head h3{
  font-family:var(--font-display);
  font-size:16px; font-weight:600; letter-spacing:-.01em;
}
.sp-list li{
  display:flex; align-items:center; gap:11px;
  font-size:14px; color:var(--ink-2);
  padding:6px 0;
}
.sp-list li::before{
  content:''; flex:0 0 6px;
  width:6px; height:6px; border-radius:50%;
  background:var(--pink-400);
}

/* ── 11. PROJECTS ─────────────────────────────────────── */
.placeholder-note{
  background:var(--pink-100);
  border:1px dashed var(--line-2);
  border-radius:var(--radius-s);
  padding:16px 20px;
  font-size:14px; color:var(--pink-700);
  margin-bottom:26px;
}
.placeholder-note code{
  font-family:var(--font-mono); font-size:12.5px;
  background:rgba(255,255,255,.7);
  padding:2px 6px; border-radius:4px;
}

.projects-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  perspective:1400px;
}
.project-card{
  position:relative;
  background:rgba(255,255,255,.82);
  backdrop-filter:blur(14px) saturate(1.4);
  -webkit-backdrop-filter:blur(14px) saturate(1.4);
  border:1px solid var(--line);
  border-radius:var(--radius-l);
  padding:28px 26px;
  box-shadow:var(--sh-1);
  overflow:hidden;
  transform-style:preserve-3d;
  transition:transform .4s var(--ease), box-shadow .4s var(--ease),
             border-color .4s;
  will-change:transform;
}
/* pink highlight sweep at the top of each card */
.project-card::before{
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--pink-300),var(--pink-500),var(--pink-300));
  transform:scaleX(0); transform-origin:left;
  transition:transform .45s var(--ease);
}
.project-card:hover::before{ transform:scaleX(1); }
.project-card:hover{
  border-color:var(--pink-300);
  box-shadow:var(--sh-3);
}
.project-card.is-placeholder{ border-style:dashed; }

.pc-top{
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:14px;
}
.pc-index{
  font-family:var(--font-display);
  font-size:30px; font-weight:900;
  color:var(--pink-200); line-height:1;
}
.pc-flag{
  font-family:var(--font-mono);
  font-size:9.5px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--pink-600);
  background:var(--pink-100);
  border:1px solid var(--line);
  padding:3px 9px; border-radius:100px;
}
.pc-flag-build{
  color:var(--pink-700);
  background:linear-gradient(135deg,var(--pink-100),var(--pink-200));
  border-color:var(--line-2);
}

.pc-title{
  font-family:var(--font-display);
  font-size:19px; font-weight:600; letter-spacing:-.015em;
  margin-bottom:9px;
}
.pc-desc{
  font-size:14px; line-height:1.72; color:var(--ink-3);
  margin-bottom:16px;
}
.pc-features{
  margin-bottom:16px;
  padding-top:14px;
  border-top:1px solid var(--line);
}
.pc-features li{
  position:relative;
  padding-left:18px;
  font-size:13px; line-height:1.6; color:var(--ink-2);
  margin-bottom:7px;
}
.pc-features li::before{
  content:''; position:absolute; left:0; top:8px;
  width:6px; height:6px; border-radius:50%;
  background:var(--pink-400);
}

.pc-tags{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:16px; }
.pc-tags li{
  font-family:var(--font-mono);
  font-size:10.5px; letter-spacing:.04em;
  color:var(--pink-700);
  background:var(--pink-100);
  border:1px solid var(--line);
  padding:4px 10px; border-radius:100px;
}
.pc-link{
  display:inline-flex; align-items:center; gap:6px;
  font-size:13px; font-weight:600; color:var(--pink-600);
  transition:gap .22s var(--ease);
}
.pc-link:hover{ gap:11px; }

/* ── 12. TIMELINE ─────────────────────────────────────── */
.timeline{ position:relative; padding-left:34px; }
.timeline::before{
  content:''; position:absolute; left:5px; top:6px; bottom:6px;
  width:2px; border-radius:1px;
  background:linear-gradient(to bottom,var(--pink-400),var(--pink-200),transparent);
}
.tl-item{ position:relative; padding-bottom:44px; }
.tl-item:last-child{ padding-bottom:0; }
.tl-dot{
  position:absolute; left:-34px; top:5px;
  width:12px; height:12px; border-radius:50%;
  background:var(--white);
  border:2.5px solid var(--pink-500);
  box-shadow:0 0 0 5px rgba(242,100,154,.10);
}
.tl-date{
  font-family:var(--font-mono);
  font-size:11.5px; letter-spacing:.06em;
  color:var(--pink-600); margin-bottom:7px;
}
.tl-role{
  font-family:var(--font-display);
  font-size:21px; font-weight:600; letter-spacing:-.02em;
  margin-bottom:3px;
}
.tl-org{
  font-size:14px; font-weight:600; color:var(--ink-3);
  margin-bottom:11px;
}
.tl-desc{
  font-size:14.5px; line-height:1.8; color:var(--ink-2);
  max-width:660px; margin-bottom:8px;
}
.tl-meta{
  font-family:var(--font-mono);
  font-size:11px; color:var(--ink-4);
}

/* ── 13. EDUCATION ────────────────────────────────────── */
.edu-card{
  display:flex; align-items:center; gap:24px;
  background:linear-gradient(120deg,var(--white),var(--surface-2));
  border:1px solid var(--line);
  border-radius:var(--radius-l);
  padding:34px 34px;
  box-shadow:var(--sh-2);
  max-width:720px;
}
.edu-badge{
  width:64px; height:64px; flex:0 0 64px;
  border-radius:18px;
  background:linear-gradient(135deg,var(--pink-200),var(--pink-300));
  display:grid; place-items:center; font-size:28px;
  box-shadow:var(--sh-1);
}
.edu-body h3{
  font-family:var(--font-display);
  font-size:22px; font-weight:600; letter-spacing:-.02em;
  margin-bottom:5px;
}
.edu-org{ font-size:14.5px; color:var(--ink-2); margin-bottom:7px; }
.edu-status{
  display:inline-block;
  font-family:var(--font-mono);
  font-size:11px; letter-spacing:.08em;
  color:var(--pink-700);
  background:var(--pink-100);
  border:1px solid var(--line);
  padding:4px 11px; border-radius:100px;
}

/* ── 14. CERTIFICATIONS ───────────────────────────────── */
.certs-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:18px;
  perspective:1200px;
}
.cert-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:24px 22px;
  box-shadow:var(--sh-1);
  display:flex; flex-direction:column;
  transform-style:preserve-3d;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease),
             border-color .35s;
  will-change:transform;
}
.cert-card:hover{
  border-color:var(--pink-300);
  box-shadow:var(--sh-2);
}
.cc-head{
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:13px;
}
.cc-issuer{
  font-family:var(--font-mono);
  font-size:10px; letter-spacing:.13em; text-transform:uppercase;
  color:var(--pink-700);
  background:var(--pink-100);
  border:1px solid var(--line);
  padding:4px 10px; border-radius:100px;
}
.cc-emoji{ font-size:20px; }
.cc-title{
  font-family:var(--font-display);
  font-size:16px; font-weight:600; line-height:1.36;
  letter-spacing:-.012em;
  margin-bottom:9px;
}
.cc-meta{ font-size:13px; color:var(--ink-3); margin-bottom:6px; }
.cc-id{
  font-family:var(--font-mono);
  font-size:10px; color:var(--ink-4);
  word-break:break-all; line-height:1.5;
  margin-top:auto; padding-top:9px;
  border-top:1px solid var(--line);
}
.cc-verify{
  margin-top:auto; padding-top:11px;
  border-top:1px solid var(--line);
  font-size:12.5px; font-weight:600; color:var(--pink-600);
  display:inline-flex; align-items:center; gap:6px;
  transition:gap .22s var(--ease);
}
.cc-verify:hover{ gap:11px; }

/* ── 15. CONTACT ──────────────────────────────────────── */
.contact-grid{
  display:grid; grid-template-columns:1fr 1fr;
  gap:56px; align-items:start;
}
.contact-heading{
  font-family:var(--font-display);
  font-size:clamp(32px,4.4vw,54px);
  font-weight:900; line-height:1.02; letter-spacing:-.035em;
  margin-bottom:18px;
}
.contact-heading em{
  font-style:italic;
  background:linear-gradient(100deg,var(--pink-500),var(--pink-700));
  -webkit-background-clip:text; background-clip:text;
  -webkit-text-fill-color:transparent; color:transparent;
}
.contact-copy{
  font-size:15.5px; line-height:1.8; color:var(--ink-2);
  max-width:420px; margin-bottom:30px;
}
.contact-list{ display:flex; flex-direction:column; gap:11px; }
.contact-row{
  display:flex; align-items:center; gap:15px;
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:16px 20px;
  box-shadow:var(--sh-1);
  transition:transform .25s var(--ease), box-shadow .25s var(--ease),
             border-color .25s;
}
a.contact-row:hover{
  transform:translateX(5px);
  border-color:var(--pink-300);
  box-shadow:var(--sh-2);
}
.contact-row.is-static{ pointer-events:none; }
.cr-icon{
  width:38px; height:38px; flex:0 0 38px; border-radius:11px;
  background:linear-gradient(135deg,var(--pink-100),var(--pink-200));
  display:grid; place-items:center;
  font-size:15px; font-weight:700; color:var(--pink-700);
}
.cr-body{ display:flex; flex-direction:column; gap:2px; min-width:0; }
.cr-label{
  font-family:var(--font-mono);
  font-size:9.5px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--ink-4);
}
.cr-value{
  font-size:14px; font-weight:500; color:var(--ink);
  overflow:hidden; text-overflow:ellipsis;
}

.contact-form{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius-l);
  padding:32px;
  box-shadow:var(--sh-2);
}
.form-note-top{
  font-size:12.5px; line-height:1.6; color:var(--ink-3);
  background:var(--pink-100);
  border-radius:var(--radius-s);
  padding:11px 14px; margin-bottom:22px;
}
.contact-form label{
  display:block;
  font-family:var(--font-mono);
  font-size:10px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--ink-3);
  margin-bottom:7px;
}
.contact-form input,
.contact-form textarea{
  width:100%;
  font-family:var(--font-body); font-size:14.5px; color:var(--ink);
  background:var(--surface-2);
  border:1.5px solid transparent;
  border-radius:var(--radius-s);
  padding:13px 16px;
  margin-bottom:18px;
  outline:none;
  transition:border-color .2s, background .2s, box-shadow .2s;
}
.contact-form input::placeholder,
.contact-form textarea::placeholder{ color:var(--ink-4); }
.contact-form input:focus,
.contact-form textarea:focus{
  background:var(--white);
  border-color:var(--pink-400);
  box-shadow:0 0 0 4px rgba(242,100,154,.10);
}
.contact-form textarea{ resize:vertical; min-height:120px; }
.form-status{
  font-size:13px; text-align:center; margin-top:13px;
  min-height:19px; color:var(--pink-700);
}

/* ── 16. FOOTER ───────────────────────────────────────── */
.footer{
  position:relative; z-index:1;
  border-top:1px solid var(--line);
  background:var(--surface-2);
  padding:30px var(--pad-x);
  display:flex; align-items:center; justify-content:space-between;
  gap:18px; flex-wrap:wrap;
}
.footer p{ font-size:13px; color:var(--ink-3); }
.footer-links{ display:flex; gap:22px; }
.footer-links a{
  font-size:12.5px; font-weight:500; color:var(--ink-3);
  transition:color .2s;
}
.footer-links a:hover{ color:var(--pink-600); }

/* ── 17. SCROLL REVEAL ────────────────────────────────── */
.reveal{
  opacity:0; transform:translateY(26px);
  transition:opacity .65s var(--ease), transform .65s var(--ease);
}
.reveal.is-visible{ opacity:1; transform:none; }

/* ── 18. RESPONSIVE ───────────────────────────────────── */
@media (max-width:1080px){
  :root{ --pad-x:36px; }
  .nav-list{ gap:22px; }
  .skills-grid,
  .projects-grid,
  .certs-grid{ grid-template-columns:repeat(2,1fr); }
}

@media (max-width:900px){
  :root{ --pad-x:24px; }
  html{ scroll-padding-top:80px; }

  .nav-list{ display:none; }
  .status-chip{ display:none; }
  .burger{ display:flex; }

  .hero{ padding:120px var(--pad-x) 80px; min-height:auto; }
  .hero-inner{ grid-template-columns:1fr; gap:48px; }
  .hero-visual{ order:-1; min-height:auto; padding:26px 0 34px; }
  .portrait-frame{ width:min(280px,68vw); }
  .fb-1{ right:-6%; }
  .fb-2{ left:-8%; }
  .fb-3{ right:-2%; }
  .scroll-hint{ display:none; }

  .section{ padding:70px var(--pad-x); }
  .about-grid,
  .contact-grid{ grid-template-columns:1fr; gap:38px; }

  .edu-card{ padding:26px; gap:18px; }
  .footer{ flex-direction:column; text-align:center; gap:12px; }
}

@media (max-width:640px){
  .skills-grid,
  .projects-grid,
  .certs-grid,
  .about-cards{ grid-template-columns:1fr; }

  .hero-cta{ flex-direction:column; align-items:stretch; }
  .hero-cta .btn{ width:100%; }

  .contact-form{ padding:24px; }
  .portrait-frame{ width:min(240px,64vw); }
  .float-badge{ padding:8px 12px; gap:8px; }
  .fb-icon{ width:26px; height:26px; flex:0 0 26px; font-size:12px; }
  .fb-body strong{ font-size:11px; }
  .fb-body small{ font-size:9.5px; }
  .edu-card{ flex-direction:column; align-items:flex-start; text-align:left; }
  .timeline{ padding-left:26px; }
  .tl-dot{ left:-26px; }
}

/* ── 19. REDUCED MOTION ───────────────────────────────── */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.01ms !important;
    scroll-behavior:auto !important;
  }
  .reveal{ opacity:1; transform:none; }
}
